# Environment variables map onto the AppConfig tree using `__` as the nesting
# delimiter, so AppConfig.db.host is set by DB__HOST. A single underscore does
# NOT work — DB_HOST matches no field and is silently ignored.

# Application Environment (development, testing, production)
APP_ENV=development

# Database (AppConfig.db)
DB__HOST=localhost
DB__PORT=5432
DB__NAME=f1db
DB__USER=gonzo_user
# Omit DB__PASSWORD to have it injected from Vault instead.
DB__PASSWORD=local_dev_password

# Logging (AppConfig.logging)
LOGGING__LEVEL=INFO

# Vault (AppConfig.vault) — optional. Leave ADDR/ROLE_ID/SECRET_ID unset and
# the Vault settings source disables itself; every value then comes from the
# variables above or the defaults in config/config.py.
# VAULT__ADDR=http://127.0.0.1:8200
# VAULT__ROLE_ID=your_role_id_here
# VAULT__SECRET_ID=your_secret_id_here
# VAULT__MOUNT_POINT=secret/data/development

# dbt reads these separately via dbt/profiles.yml
F1DB_HOST=localhost
F1DB_USER=gonzo_user
F1DB_PASSWORD=local_dev_password
