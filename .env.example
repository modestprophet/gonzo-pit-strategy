# Application Environment (development, testing, production)
APP_ENV=development

# Vault Credentials (Required for the Vault Adapter)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROLE_ID=your_role_id_here
VAULT_SECRET_ID=your_secret_id_here

# Database Configuration (Mapped to AppConfig.db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gonzo
DB_USER=gonzo_user
# DB_PASSWORD is not here; it will be injected by the Vault Adapter!

# Logging Configuration
LOG_LEVEL=INFO