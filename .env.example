# Settings use `__` for nested fields, so DB__HOST sets the database host.
# DB_HOST matches no field and is ignored.

# Database (AppConfig.db)
DB__HOST=localhost
DB__PORT=5432
DB__NAME=f1db
DB__USER=gonzo_user
# Supplying DB__PASSWORD bypasses Vault. There is no password default in code.
# Omit it only when Vault is configured to supply the password.
DB__PASSWORD=local_dev_password

# Logging (AppConfig.logging)
LOGGING__LEVEL=INFO

# Vault is needed only when DB__PASSWORD is absent.
# Then ADDR, ROLE_ID, and SECRET_ID are required. Authentication or secret-read
# failures stop startup. MOUNT_POINT is the raw path prefix, including /data/
# for KV v2. Multipass reads <MOUNT_POINT>/password and accepts password or value.
# VAULT__ADDR=http://127.0.0.1:8200
# VAULT__ROLE_ID=your_role_id_here
# VAULT__SECRET_ID=your_secret_id_here
# VAULT__MOUNT_POINT=secret/data/development

# dbt reads these separately via dbt/profiles.yml
F1DB_HOST=localhost
F1DB_USER=gonzo_user
F1DB_PASSWORD=local_dev_password
